# Keep the real BOT_TOKEN and DATABASE_URL in private hosting environment variables.
BOT_TOKEN=YOUR_PRIVATE_TELEGRAM_BOT_TOKEN
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zona
NODE_ENV=production
PORT=3000
# Origin only (no /dark/ path). Adjust if GitHub Pages uses a custom domain.
ALLOWED_ORIGINS=https://elyxiumcoin.github.io
